// -----------------------------------------------------
// NIRI
// -----------------------------------------------------

input {
    keyboard {
        xkb {
        }
        numlock
    }

    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}

// -----------------------------------------------------
// 4, MONITORS, LEFT, MIDDLE (90), RIGHT, TOP
// -----------------------------------------------------

// LEFT
output "DP-1" {
    mode "3840x2160@59.98"
    scale 1.0
    transform "normal"
    position x=0 y=0
    background-color "#000000"
}

// MIDDLE
output "DP-2" {
    mode "3840x2160@59.98"
    scale 1.0
    transform "90"
    position x=3840 y=0
    background-color "#000000"
}

// RIGHT
output "DP-3" {
    mode "3840x2160@59.98"
    scale 1.0
    transform "normal"
    position x=6000 y=0
    background-color "#000000"
}

// TOP
output "HDMI-A-1" {
    mode "3840x2160@29.95"
    scale 1.5
    transform "normal"
    position x=6000 y=-1440
    background-color "#000000"
}

// -----------------------------------------------------
// LAYOUT
// -----------------------------------------------------

layout {
    gaps 6

    center-focused-column "never" // never, always, on-overflow

    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }

    default-column-width {}

    focus-ring {
        off
    }

    border {
        width 3
        inactive-color "#202020"
        active-gradient from="#FF3300" to="#662F90" angle=0
        urgent-color "#00CC00"
    }

    insert-hint {
        gradient from="#0095a8" to="#00616F" angle=0
    }
}

// -----------------------------------------------------
// SPAWN AT STARTUP
// -----------------------------------------------------

spawn-at-startup "kitty"
spawn-at-startup "google-chrome-stable"

// -----------------------------------------------------
// WINDOW DESIGN AND VARS
// -----------------------------------------------------

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd // remove rounded corners

window-rule {
    // ROUNDING
    geometry-corner-radius 3
    clip-to-geometry true
}

window-rule {
    match is-active=false
    // opacity 0.5 // MAKE INACTIVE WINDOWS SEMITRANSPARENT ?
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    // off
    // slowdown 3.0
}

// -----------------------------------------------------
// HOTKEY KEYBINDINGS
// -----------------------------------------------------

binds {
    // SHOW KEYBINDINGS CHEAT SHEET
    Mod+Shift+Slash { show-hotkey-overlay; }

    // APPS
    Mod+T { spawn "kitty"; }
    Mod+E { spawn "nautilus"; }
    Mod+G { spawn "google-chrome-stable"; }
    Mod+I { spawn-sh "pkill hyprpicker || hyprpicker -a -f hex"; }

    Mod+Space { spawn "fuzzel"; }
    // Mod+Space { spawn "/home/praystation/.local/bin/app-launcher-gtk"; }

    // VOLUME = FN+F10 (MUTE) / FN+F11 (AUDIO -) / FN+F12 (AUDIO +)
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // WINDOW / OVERVIEW
    Mod+O repeat=false { toggle-overview; }

    // WINDOW / CLOSE
    Mod+Q repeat=false { close-window; }

    // MOVEMENT / FOCUS WINDOW
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    // MOVEMENT / FOCUS MONITOR
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }

    // MOVEMENT / SHIFT WINDOW POSITION
    Mod+Alt+Left  { move-column-left; }
    Mod+Alt+Down  { move-window-down; }
    Mod+Alt+Up    { move-window-up; }
    Mod+Alt+Right { move-column-right; }

    // MOVEMENT / RESIZE WINDOW / 25% 50% 75% 100%
    Mod+Ctrl+Right { switch-preset-column-width; }
    Mod+Ctrl+Left { switch-preset-column-width-back; }

    // MOVEMENT / JUMP WORKSPACE UP/DOWN
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }

    // MOVEMENT / MOVE WINDOW TO WORKSPACE UP/DOWN
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    // MOVEMENT / WORKSPACE + WORKSPACE MOVE + UP/DOWN / WITH SCOLLWHEEL / FANCY !
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // MOVEMENT / WINDOW CONSUME INTO A COLUMN
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // MOVEMENT / WINDOW / MAX / FULLSCREEN / FILL / CENTER
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }

    // MOVEMENT / WINDOW RESIZE - + 10%
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // SCREENTSHOTS
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // The allow-inhibiting=false property can be applied to other binds as well,
    // which ensures niri always processes them, even when an inhibitor is active.
    // Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // QUIT NIRI
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // KEEP COMPUTER ON / TURN OFF SCREENS
    Mod+Shift+P { power-off-monitors; }
}

// -----------------------------------------------------
// CURSOR SETTINGS
// -----------------------------------------------------

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 36
}

